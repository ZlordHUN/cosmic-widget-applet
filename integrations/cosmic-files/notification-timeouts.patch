+fn notification_timeout(notification: &Notification, config: &NotificationsConfig) -> Duration {
+    let timeout = u32::try_from(notification.expire_timeout).unwrap_or(3000);
+    let max_timeout = match notification.urgency() {
+        2 => config.max_timeout_urgent,
+        1 => config.max_timeout_normal,
+        _ => config.max_timeout_low,
+    }
+    .unwrap_or(timeout);
+    Duration::from_millis(u64::from(timeout.min(max_timeout)))
+}
 
