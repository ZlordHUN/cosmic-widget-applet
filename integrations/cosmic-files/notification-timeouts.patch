+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cosmic::iced::futures::StreamExt;
+    use cosmic_notifications_util::Hint;
+    use std::time::SystemTime;
+
+    fn app() -> CosmicNotifications {
+        CosmicNotifications {
+            core: Core::default(),
+            active_surface: false,
+            window_id: SurfaceId::unique(),
+            cards: Vec::new(),
+            hidden: VecDeque::new(),
+            timeout_generations: HashMap::new(),
+            next_timeout_generation: 0,
+            notifications_id: id::Id::unique(),
+            notifications_tx: None,
+            config: NotificationsConfig {
+                do_not_disturb: true,
+                max_notifications: 0,
+                max_timeout_normal: Some(12),
+                ..NotificationsConfig::default()
+            },
+            dock_config: CosmicPanelConfig::default(),
+            panel_config: CosmicPanelConfig::default(),
+            anchor: None,
+            popups: Vec::new(),
+        }
+    }
+
+    fn notification(expire_timeout: i32, summary: &str) -> Notification {
+        Notification {
+            id: 42,
+            app_name: "Transfer timeout regression".into(),
+            app_icon: String::new(),
+            summary: summary.into(),
+            body: String::new(),
+            actions: Vec::new(),
+            hints: Vec::new(),
+            expire_timeout,
+            time: SystemTime::now(),
+        }
+    }
+
+    async fn timeout_message(task: Task<Message>) -> Message {
+        let mut stream = iced::runtime::task::into_stream(task)
+            .expect("a finite notification lifetime must schedule a task");
+        match tokio::time::timeout(Duration::from_secs(1), stream.next())
+            .await
+            .expect("notification timeout did not run")
+        {
+            Some(iced::runtime::Action::Output(cosmic::Action::App(
+                message @ Message::Timeout(..),
+            ))) => message,
+            other => panic!("expected notification timeout, got {other:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn persistent_transfer_completion_expires_and_keeps_history() {
+        for timeout in [-1, 12] {
+            let mut app = app();
+            let _ = app.push_notification(notification(0, "Copying"));
+            assert!(app.timeout_generations.is_empty());
+
+            let task = app.replace_notification(notification(timeout, "Copy complete"));
+            let message = timeout_message(task).await;
+            let _ = app.update(message);
+
+            assert!(app.cards.is_empty());
+            assert!(app.timeout_generations.is_empty());
+            assert_eq!(app.hidden.len(), 1);
+            assert_eq!(app.hidden[0].summary, "Copy complete");
+        }
+    }
+
+    #[tokio::test]
+    async fn replacement_restarts_timeout_and_ignores_previous_timer() {
+        let mut app = app();
+        let old = app.push_notification(notification(1, "First"));
+        let replacement = app.replace_notification(notification(12, "Updated"));
+
+        let _ = app.update(timeout_message(old).await);
+        assert_eq!(app.cards.len(), 1);
+        assert_eq!(app.cards[0].summary, "Updated");
+        assert!(app.hidden.is_empty());
+
+        let _ = app.update(timeout_message(replacement).await);
+        assert!(app.cards.is_empty());
+        assert_eq!(app.hidden[0].summary, "Updated");
+    }
+
+    #[tokio::test]
+    async fn persistent_replacement_cancels_previous_timeout() {
+        let mut app = app();
+        let old = app.push_notification(notification(1, "Starting"));
+        let replacement = app.replace_notification(notification(0, "Copying"));
+        assert!(iced::runtime::task::into_stream(replacement).is_none());
+
+        let _ = app.update(timeout_message(old).await);
+        assert_eq!(app.cards.len(), 1);
+        assert_eq!(app.cards[0].summary, "Copying");
+        assert!(app.hidden.is_empty());
+        assert!(app.timeout_generations.is_empty());
+    }
+
+    #[tokio::test]
+    async fn close_clears_timeout_without_reusing_its_generation() {
+        let mut app = app();
+        let old = app.push_notification(notification(1, "First"));
+        let _ = app.close(42, CloseReason::CloseNotification);
+        assert!(app.timeout_generations.is_empty());
+
+        let replacement = app.push_notification(notification(12, "Reused id"));
+        let _ = app.update(timeout_message(old).await);
+        assert_eq!(app.cards.len(), 1);
+        assert!(app.hidden.is_empty());
+
+        let _ = app.update(timeout_message(replacement).await);
+        assert!(app.cards.is_empty());
+        assert_eq!(app.hidden[0].summary, "Reused id");
+        let _ = app.close(42, CloseReason::Dismissed);
+        assert!(app.hidden.is_empty());
+        assert!(app.timeout_generations.is_empty());
+    }
+
+    #[test]
+    fn timeout_preserves_default_explicit_and_urgency_limits() {
+        let config = NotificationsConfig {
+            max_timeout_low: Some(1000),
+            max_timeout_normal: Some(2000),
+            max_timeout_urgent: None,
+            ..NotificationsConfig::default()
+        };
+        for (urgency, expected_default, expected_long) in
+            [(0, 1000, 1000), (1, 2000, 2000), (2, 3000, 8000)]
+        {
+            for (timeout, expected) in [
+                (0, 0),
+                (-1, expected_default),
+                (100, 100),
+                (8000, expected_long),
+            ] {
+                let mut notification = notification(timeout, "Timeout policy");
+                notification.hints.push(Hint::Urgency(urgency));
+                assert_eq!(
+                    notification_timeout(&notification, &config),
+                    Duration::from_millis(expected)
+                );
+            }
+        }
+    }
+}
