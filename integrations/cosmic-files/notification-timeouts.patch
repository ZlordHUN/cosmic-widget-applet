+    fn schedule_timeout(&mut self, notification: &Notification) -> Task<Message> {
+        // Replacing a card also replaces its lifetime. Invalidate any already queued
+        // timeout, including when the replacement requests an indefinite lifetime.
+        let id = notification.id;
+        self.timeout_generations.remove(&id);
+        let timeout = notification_timeout(notification, &self.config);
+        if timeout.is_zero() {
+            return Task::none();
+        }
+
+        let generation = self.next_timeout_generation;
+        self.next_timeout_generation = self.next_timeout_generation.wrapping_add(1);
+        self.timeout_generations.insert(id, generation);
+        iced::Task::perform(tokio::time::sleep(timeout), move |_| {
+            cosmic::action::app(Message::Timeout(id, generation))
+        })
+    }
