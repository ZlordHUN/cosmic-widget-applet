+fn mpris_is_paused(current: gst::State, pending: gst::State) -> bool {
+    // A flushing seek briefly prerolls in Paused before returning to Playing.
+    // Publish the target state so that MPRIS clients do not see a false pause.
+    match pending {
+        gst::State::Playing => false,
+        gst::State::Paused => true,
+        _ => current == gst::State::Paused,
+    }
+}
+
+fn mpris_seek_target(
+    current: f64,
+    duration: f64,
+    amount_micros: i64,
+    relative: bool,
+) -> Option<f64> {
+    if !current.is_finite() || !duration.is_finite() || duration <= 0.0 {
+        return None;
+    }
+    let amount = amount_micros as f64 / 1_000_000.0;
+    if relative {
+        Some((current + amount).clamp(0.0, duration))
+    } else {
+        (0.0..=duration).contains(&amount).then_some(amount)
+    }
+}
