+#[cfg(test)]
+mod tests {
+    use super::*;
+    use futures::StreamExt;
+
+    fn player() -> (Player, futures::channel::mpsc::Receiver<Message>) {
+        let (tx, rx) = futures::channel::mpsc::channel(8);
+        (
+            Player {
+                msg_tx: Mutex::new(tx),
+                meta: Mutex::new(MprisMeta {
+                    url_opt: Some(url::Url::parse("file:///tmp/episode-one.mkv").unwrap()),
+                    duration_micros: 60_000_000,
+                    seekable: true,
+                    ..Default::default()
+                }),
+                state: Mutex::new(MprisState::default()),
+            },
+            rx,
+        )
+    }
+
+    #[test]
+    fn relative_seek_forwards_signed_microseconds_without_playback_messages() {
+        futures::executor::block_on(async {
+            let (player, mut rx) = player();
+            player.seek(Time::from_micros(-10_000_000)).await.unwrap();
+            assert!(matches!(
+                rx.next().await,
+                Some(Message::MprisSeek {
+                    amount_micros: -10_000_000,
+                    relative: true,
+                    ..
+                })
+            ));
+            assert!(rx.try_recv().is_err());
+        });
+    }
+
+    #[test]
+    fn absolute_seek_validates_track_and_position() {
+        futures::executor::block_on(async {
+            let (player, mut rx) = player();
+            let track_id = player.meta.lock().await.track_id();
+            let stale_id = TrackId::try_from("/old/track").unwrap();
+            player
+                .set_position(stale_id, Time::from_secs(20))
+                .await
+                .unwrap();
+            player
+                .set_position(track_id.clone(), Time::from_micros(-1))
+                .await
+                .unwrap();
+            player
+                .set_position(track_id.clone(), Time::from_secs(61))
+                .await
+                .unwrap();
+            assert!(rx.try_recv().is_err());
+            player
+                .set_position(track_id, Time::from_secs(20))
+                .await
+                .unwrap();
+            assert!(matches!(
+                rx.next().await,
+                Some(Message::MprisSeek {
+                    amount_micros: 20_000_000,
+                    relative: false,
+                    ..
+                })
+            ));
+            assert!(rx.try_recv().is_err());
+        });
+    }
+
+    #[test]
+    fn unseekable_media_ignores_seek_commands() {
+        futures::executor::block_on(async {
+            let (player, mut rx) = player();
+            let track_id = {
+                let mut meta = player.meta.lock().await;
+                meta.seekable = false;
+                meta.track_id()
+            };
+            assert!(!player.can_seek().await.unwrap());
+            player.seek(Time::from_secs(10)).await.unwrap();
+            player
+                .set_position(track_id, Time::from_secs(20))
+                .await
+                .unwrap();
+            assert!(rx.try_recv().is_err());
+        });
+    }
+
+    #[test]
+    fn track_identity_changes_with_media_and_clears_when_closed() {
+        let mut meta = MprisMeta::default();
+        assert_eq!(meta.track_id(), TrackId::NO_TRACK);
+        meta.url_opt = Some(url::Url::parse("file:///tmp/episode-one.mkv").unwrap());
+        let first = meta.track_id();
+        meta.url_opt = Some(url::Url::parse("file:///tmp/episode-two.mkv").unwrap());
+        assert_ne!(meta.track_id(), first);
+    }
+}
